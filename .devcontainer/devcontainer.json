{
  "name": "PF2e Kingdom VK Environment",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspace",
  "customizations": {
    "vscode": {
      "settings": {
        "editor.formatOnSave": true
      },
      "extensions": [
        "dbaeumer.vscode-eslint"
      ]
    }
  },
  "remoteUser": "root",
  "postCreateCommand": "npm install -g @foundryvtt/foundryvtt-cli && git config --global --add safe.directory '*'"
}